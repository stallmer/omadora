#!/usr/bin/env bash
# Set up the user's configuration.
#   omadora-setup --skel            copy Omadora's default files into $HOME; never overwrites
#   omadora-setup <repo>            use a chezmoi dotfiles repository (any URL git accepts)
#   omadora-setup --update          pull and apply your dotfiles repository; does nothing if you have none
#   --force                         with <repo> or --update, overwrite local changes
set -euo pipefail

SOURCE="${XDG_DATA_HOME:-${HOME}/.local/share}/chezmoi"
SKEL="${OMADORA_SKEL:-/usr/share/omadora/skel}"
USAGE="usage: omadora-setup --skel | --update [--force] | [--force] <repo-url>"

mode=""
repo=""
force=()
for arg in "$@"; do
	case "${arg}" in
		--skel | --update)
			[[ -z "${mode}" ]] || { echo "${USAGE}" >&2; exit 2; }
			mode="${arg#--}"
			;;
		--force) force=(--force) ;;
		-h | --help)
			sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		-*)
			echo "${USAGE}" >&2
			exit 2
			;;
		*)
			[[ -z "${mode}" ]] || { echo "${USAGE}" >&2; exit 2; }
			mode="init"
			repo="${arg}"
			;;
	esac
done

case "${mode}" in
	skel)
		# Copies only what is missing, so nothing the user changed is ever overwritten.
		cp -rT --update=none "${SKEL}" "${HOME}"
		;;
	update)
		if [[ ! -d "${SOURCE}/.git" ]]; then
			echo "omadora-setup: no dotfiles repository is set; use 'omadora-setup <repo-url>' to set one"
			exit 0
		fi
		chezmoi update "${force[@]}"
		;;
	init)
		if [[ -d "${SOURCE}/.git" ]]; then
			current="$(git -C "${SOURCE}" remote get-url origin 2>/dev/null || echo "an unknown repository")"
			echo "omadora-setup: ${SOURCE} already holds ${current}; run 'omadora-setup --update', or move that directory aside first" >&2
			exit 1
		fi
		chezmoi init --apply "${force[@]}" "${repo}"
		;;
	*)
		echo "${USAGE}" >&2
		exit 2
		;;
esac
